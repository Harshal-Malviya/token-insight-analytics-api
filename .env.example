# Server Environment Configuration
PORT=3000
NODE_ENV=development

# AI Provider Options: openai | huggingface | llamacpp
AI_PROVIDER=openai

# OpenAI API Key & Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Hugging Face API Configuration (Optional if AI_PROVIDER=huggingface)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1

# Local Llama.cpp Endpoint (Optional if AI_PROVIDER=llamacpp)
LLAMACPP_URL=http://localhost:8080/v1/chat/completions

# External API Base URLs
COINGECKO_API_URL=https://api.coingecko.com/api/v3
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz/info
